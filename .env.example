# Copy to .env (never commit .env). Real secrets live only on the server.

# development | production. In production, cookies are Secure and dev shortcuts are refused.
APP_ENV=development
# Local development default is 127.0.0.1:8080. On cloud platforms (Render, Railway, Fly.io),
# the server automatically binds to 0.0.0.0:$PORT using the provided PORT env var.
BIND=127.0.0.1:8080

# Local:    postgres://USER:PASSWORD@localhost:5432/wagwell
# Supabase: use the SESSION pooler (port 5432), not the 6543 transaction pooler (it can't keep the
#           prepared statements sqlx uses) and not db.<ref>.supabase.co (IPv6-only):
#           postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Percent-encode special characters in the password.
DATABASE_URL=postgres://wagwell:change-me@localhost:5432/wagwell

# Websites allowed to call the API with cookies (comma-separated, no trailing slash).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# At least 32 random characters; mixed into stored OTP hashes. Generate: openssl rand -hex 32
OTP_PEPPER=replace-with-64-random-hex-characters-0123456789abcdef0123456789abcdef

# Development only: print one-time codes in the server log instead of sending an SMS.
# The server refuses to start with this on when APP_ENV=production.
OTP_DEV_ECHO=true

# Image storage, S3-compatible (Supabase: Project Settings → Storage → S3 access keys).
# Server-only — these keys can read, write and delete every file. Leave all unset to switch uploads off.
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=ap-southeast-1
# S3_BUCKET=image_pet
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Where browsers load pictures from (the bucket must be set to Public in Supabase):
# STORAGE_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/image_pet

# Online payments (Razorpay). Server-only secrets: never in a website, never in git.
# Leave all three unset to offer cash on delivery only. Use rzp_test_ keys until launch
# (development refuses rzp_live_ keys). Webhook URL in the Razorpay dashboard:
#   https://<api-host>/api/v1/payments/razorpay/webhook   (events: payment.captured, payment.failed, refund.processed, refund.failed)
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Sign-in codes by SMS (MSG91, DLT-registered — required for SMS in India). Server-only.
# Without these, production can't send codes and customers can't sign in (development logs them
# instead when OTP_DEV_ECHO=true). The template must contain the code variable, e.g. ##otp##.
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_OTP_VAR=otp
